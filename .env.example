# ── Global Application ────────────────────────────────────────────────────────
APP_ENV=production
# APP_ENV options: development | staging | production

LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── DiskGuard Threshold ───────────────────────────────────────────────────────
# Trigger purge jika SALAH SATU kondisi terpenuhi (OR logic)
DISK_GUARD_THRESHOLD_GB=5
DISK_GUARD_THRESHOLD_PCT=80

# ── Kamera 01 (Koridor Utama) ─────────────────────────────────────────────────
# URL RTSP akan di-build: rtsp://<USER>:<PASS>@<HOST>:<PORT><PATH>
# Password akan di-URL-encode otomatis oleh config_loader (karakter spesial aman)
CAM_01_USER=admin
CAM_01_PASS=changeme
CAM_01_HOST=192.168.1.101
CAM_01_PORT=554
CAM_01_PATH=/Streaming/Channels/102

# ── Kamera 02 (Koridor & Transit Depan) ───────────────────────────────────────
CAM_02_USER=admin
CAM_02_PASS=changeme
CAM_02_HOST=192.168.1.102
CAM_02_PORT=554
CAM_02_PATH=/Streaming/Channels/102

# ── Kamera 03 (Area Transit Tengah) ───────────────────────────────────────────
CAM_03_USER=admin
CAM_03_PASS=changeme
CAM_03_HOST=192.168.1.103
CAM_03_PORT=554
CAM_03_PATH=/Streaming/Channels/102

# ── Kamera 04 (Area Pintu Masuk / Gudang) ──────────────────────────────────────
CAM_04_USER=admin
CAM_04_PASS=changeme
CAM_04_HOST=192.168.1.104
CAM_04_PORT=554
CAM_04_PATH=/Streaming/Channels/102
