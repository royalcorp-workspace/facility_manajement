# ── Global Application ────────────────────────────────────────────────────────
APP_ENV=production
# APP_ENV options: development | staging | production

LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR | CRITICAL

API_KEY=facility-royal-2026
# API_KEY authentication token for REST endpoints and video streaming

# ── DiskGuard Threshold ───────────────────────────────────────────────────────
# Trigger purge jika SALAH SATU kondisi terpenuhi (OR logic)
DISK_GUARD_THRESHOLD_GB=5
DISK_GUARD_THRESHOLD_PCT=80

# ── Kamera 01 (Koridor Utama) ─────────────────────────────────────────────────
# URL RTSP akan di-build: rtsp://<USER>:<PASS>@<HOST>:<PORT><PATH>
# Password akan di-URL-encode otomatis oleh config_loader (karakter spesial aman)
CAM_01_USER=admin
CAM_01_PASS=changeme
CAM_01_HOST=192.168.1.101
CAM_01_PORT=554
CAM_01_PATH=/Streaming/Channels/102

# ── Kamera 02 (Motorcycle Area - 192.212.160.173) ─────────────────────────────
CAM_02_USER=user
CAM_02_PASS=royalpusat314
CAM_02_HOST=192.212.160.173
CAM_02_PORT=554
CAM_02_PATH=/Streaming/Channels/102

